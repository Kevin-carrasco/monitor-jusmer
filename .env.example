# Copiar como .env y completar. El archivo .env no se sube al repositorio.
#
# demo: respuestas simuladas | base: lectura en vivo de Supabase
MONITOR_MODO=demo

# Conexión a Supabase (Connect > transaction pooler), con un usuario de solo lectura
SD_HOST=
SD_PORT=6543
SD_DBNAME=postgres
SD_USER=
SD_PASSWORD=
SD_TABLE=jusmer_ola1_responses

# Opcionales
# MONITOR_META_N=3000
# MONITOR_REFRESCO_SEG=60
